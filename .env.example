# Docker Compose secrets. Copy this file to .env and fill both required values.
POSTGRES_USER=fly_arrangement
POSTGRES_PASSWORD=
POSTGRES_DB=fly_arrangement
POSTGRES_PORT=15432

# Use a cryptographically random value with at least 32 characters.
JWT_SECRET_KEY=
ENVIRONMENT=production

# Local-only default. Set to 0.0.0.0 only when you intentionally provide LAN access
# and have configured suitable network and HTTPS protections.
APP_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=13000
BACKEND_PORT=18000

# Public HTTPS root used by Feishu callbacks in server deployments.
PUBLIC_API_BASE_URL=http://localhost:18000

# Optional Feishu integration settings.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_NAME=
FEISHU_ENABLE_SIGNATURE_CHECK=true
FEISHU_ENABLE_WHITELIST=false
FEISHU_WHITELIST_OPEN_IDS=
