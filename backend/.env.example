# Local development / desktop default (SQLite). Docker Compose supplies its own
# PostgreSQL DATABASE_URL from the root .env file.
DATABASE_URL=sqlite+aiosqlite:///./data/fly_arrangement.db
ENVIRONMENT=dev
# The built-in development JWT key is local-only. Production must set a random
# JWT_SECRET_KEY of at least 32 characters in the root .env file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_NAME=
PUBLIC_API_BASE_URL=
FEISHU_ENABLE_SIGNATURE_CHECK=true
FEISHU_ENABLE_WHITELIST=false
FEISHU_WHITELIST_OPEN_IDS=

# Ollama 主链路（/api/chat）超时与重试
OLLAMA_CHAT_TIMEOUT_SECONDS=180
OLLAMA_CHAT_RETRIES=2
OLLAMA_CHAT_RETRY_DELAY_SECONDS=2

# Ollama 预热链路超时与重试
OLLAMA_WARMUP_TIMEOUT_SECONDS=60
OLLAMA_WARMUP_RETRIES=3
OLLAMA_WARMUP_RETRY_DELAY_SECONDS=3
